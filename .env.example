# CoreAPI configuration.
#
# This file is read from two places, and it has to exist in both of them:
#
#   ./.env      the Go API reads it from its own working directory.
#   ./cc/.env   the C# engine (coreconsole) reads it from ITS working
#               directory; without it the engine exits with code 4 and the
#               API answers 503.
#
# Every value below is an EXAMPLE. Change the keys, the DSNs and the URLs
# before running this outside of your own machine.

# The app refuses to start ("Not configured yet, please configure") while this
# is false, so it has to be true to run.
CONFIGURED=true

# The environment the program is running in: production or development.
ENV=development

# ip:port pair the HTTP server binds to.
HTTP_ADDR=:8080

# Public base URL of this API.
HTTP_BASE_URL=http://localhost:8080

# HTTP salted session key (change this to log out all the users).
HTTP_SESSION_KEY=change-me-to-a-random-session-key

# CIDR ranges allowed to provide an X-Forwarded-For header. The parser reads
# a single value here, a comma separated list is not supported, and an empty
# value is read as one empty proxy and makes the server refuse to start.
HTTP_TRUSTED_PROXIES=127.0.0.1/32

# Key used to validate the session cookies (32 or 64 bytes).
HTTP_VALIDATION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Key used to encrypt the session cookies (32 bytes).
HTTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Sentry DSN used by the Go API.
LOGGING_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry DSN used by the C# engine, which reads it from its own .env file.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
